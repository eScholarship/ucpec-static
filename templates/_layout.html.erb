<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= page_title ? "#{h(page_title)} | #{h(SITE_TITLE)}" : h(SITE_TITLE) %></title>
  <style>
    <%= base_css %>

    <%= page_css %>
  </style>
  <!-- Klaro styling -->
  <link rel="stylesheet" href="<%= base_path %>assets/klaro/klaro-ui.css">
  <!-- Matomo (gated by Klaro consent) -->
  <script type="text/plain" data-type="application/javascript" data-name="matomo-tracking">
    var _paq = window._paq = window._paq || [];
    /* tracker methods like "setCustomDimension" should be called before "trackPageView" */
    _paq.push(['trackPageView']);
    _paq.push(['enableLinkTracking']);
    (function() {
      var u="https://matomo.cdlib.org/";
      _paq.push(['setTrackerUrl', u+'matomo.php']);
      _paq.push(['setSiteId', '13']);
      var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
      g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);
    })();
  </script>
  <!-- End Matomo Code -->
  <!-- Klaro consent manager -->
  <script defer src="<%= base_path %>assets/klaro/klaro-config.js"></script>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <header class="site-header">
    <div class="container">
      <div class="brand-container">
        <p class="brand"><a href="<%= base_path %>index.html"><%= h(BRAND_NAME) %></a></p>
      </div>
    </div>
  </header>
  <nav class="secondary-nav">
    <div class="container secondary-nav-inner">
      <div class="secondary-nav-left">
        <a href="<%= base_path %>index.html">Home</a>
        <a href="<%= base_path %>about.html">About</a>
        <a href="<%= base_path %>help.html">Help</a>
      </div>
      <div class="secondary-nav-right">
        <span class="browse-label">Browse by:</span>
        <a href="<%= base_path %>browse_subject.html">Subject</a>
        <a href="<%= base_path %>browse_title.html">Title</a>
        <a href="<%= base_path %>browse_author.html">Author</a>
      </div>
    </div>
  </nav>

  <section class="accessibility-notice" aria-label="accessibility notice">
	  <div>
	  	<img id="acc-icon" src="/img/acc-icon.svg" aria-hidden="true"/>
	  </div>
    <div>
      This website contains archived content made available for reference, research, or recordkeeping purposes. These materials are not actively maintained and may not meet current accessibility standards, such as WCAG 2.1 Level AA. If you need assistance accessing this content or require an accessible format, <a href="https://cdlib.org/about/policies-and-guidelines/accessibility/">please contact us</a>. We are committed to ensuring access for all users and will provide accommodations promptly upon request.
    </div> 
  </section>

  <main class="document-content" id="main-content" tabindex="-1">
    <div class="container">
      <%= page_content %>
    </div>
  </main>

  <footer class="site-footer">
    <div class="footer-logos">
      <a href="http://www.ucpress.edu"><img src="/img/ucpress_logo.svg" alt="University of California Press logo" class="footer-logo"></a>
      <a href="http://www.cdlib.org"><img src="/img/CDL_Logo.svg" alt="California Digital Library logo" class="footer-logo"></a>
    </div>
    <div class="container">
      <div class="footer-links">
        <a href="<%= base_path %>help.html">Help</a>
        <a href="https://cdlib.org/about/policies-and-guidelines/privacy-statement/">Privacy Policy</a>
        <a href="https://cdlib.org/about/policies-and-guidelines/accessibility/">Accessibility Statement</a>
      </div>
      <p>
        <%= h(BRAND_NAME) %> is a joint project of the <a href="https://cdlib.org">California Digital Library</a> and <a href="https://ucpress.edu">University of California Press</a>.
      </p>
      <p>&copy; 2026 The Regents of the University of California</p>
    </div>
  </footer>
  <% if page_js && !page_js.empty? -%>
    <script><%= page_js %></script>
  <% end -%>
</body>
</html>
